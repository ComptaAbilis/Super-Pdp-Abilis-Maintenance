# Copier ce fichier en .env et le remplir. Ne JAMAIS commiter .env.

# Une application SUPER PDP par entreprise (menu Applications > Nouvelle application…)
SUPERPDP_APPLICATIONS=[{"client_id":"...","client_secret":"..."},{"client_id":"...","client_secret":"..."}]

# Application Microsoft Entra (créée par l'informatique), permission Graph Sites.Selected sur le site ci-dessous
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Site SharePoint et dossier de destination (chemin dans la bibliothèque)
SHAREPOINT_SITE_URL=https://groupeabilisfr.sharepoint.com/sites/msteams_fa2c43_543535-CommunityDAF
