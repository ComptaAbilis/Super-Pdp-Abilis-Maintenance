# Copier ce fichier en .env et le remplir. Ne JAMAIS commiter .env.

# Une application SUPER PDP par entreprise (menu Applications > Nouvelle application…)
SUPERPDP_APPLICATIONS=[{"client_id":"...","client_secret":"..."}]

# Application Microsoft Entra fournie par l'informatique (fiche technique « Connexions Externes pour automatisations »)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Dossier SharePoint autorisé, toujours adressé par ses identifiants (driveId + folderId de la fiche)
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=
